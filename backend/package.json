{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "prepare": "cd .. && npx husky",
    "dev": "nodemon --watch src --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "dotenv -e ../.env -- npx sequelize-cli db:migrate",
    "db:migrate:undo": "dotenv -e ../.env -- npx sequelize-cli db:migrate:undo",
    "db:seed": "dotenv -e ../.env -- npx sequelize-cli db:seed:all",
    "db:model:create": "dotenv -e ../.env -- npx sequelize-cli model:generate",
    "test": "dotenv -e ../.env -- vitest",
    "test:ui": "dotenv -e ../.env -- vitest --ui",
    "test:run": "dotenv -e ../.env -- vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.1.0",
    "jspdf-autotable": "^5.0.7",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.9.2",
    "@types/supertest": "^6.0.3",
    "@vitest/ui": "^4.0.13",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^16.2.6",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^4.0.13"
  },
  "lint-staged": {
    "src/**/*.{js,mjs,cjs,ts,mts,cts,jsx,tsx}": [
      "npx eslint --config eslint.config.mts --fix",
      "npx prettier --write"
    ]
  }
}
